# Copie para .env e ajuste.
# Segredos de CI/deploy ficam no GitHub Secrets, não aqui.

# API
NODE_ENV=development
API_PORT=3333

# Web: público, vai para o JavaScript do navegador. Nunca coloque segredo em VITE_*.
WEB_PORT=8080
VITE_API_URL=http://localhost:3333

# Postgres local (docker compose). Mesmos valores padrão do compose.
POSTGRES_USER=devland
POSTGRES_PASSWORD=devland
POSTGRES_DB=devland

# API em modo dev (npm run dev), fora do Docker: aponta para o Postgres do compose
DATABASE_URL=postgres://devland:devland@localhost:5432/devland

# Porta do Postgres em 127.0.0.1. Se mudar, ajuste a porta na DATABASE_URL também.
DB_PORT=5432

# Feature flag: "false" desliga as animações da vitrine
VITE_FLAG_SHOWCASE_ANIMATIONS=true
