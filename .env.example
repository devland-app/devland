# Copie para .env e ajuste.
# Segredos de CI/deploy ficam no GitHub Secrets, não aqui.

# API
NODE_ENV=development
API_PORT=3333

# Web: público, vai para o JavaScript do navegador. Nunca coloque segredo em VITE_*.
WEB_PORT=8080
VITE_API_URL=http://localhost:3333

# Postgres local (docker compose). Mesmos valores padrão do compose.
POSTGRES_USER=devzoo
POSTGRES_PASSWORD=devzoo
POSTGRES_DB=devzoo
